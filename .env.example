# Supabase – Projekt-Einstellungen > API
VITE_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
VITE_SUPABASE_ANON_KEY=dein-anon-public-key

# Admin-PIN fürs Organisator-Panel (frei wählbar, NICHT geheim-kritisch)
VITE_ADMIN_PIN=1909

# Plan-Inhalt (Adressen, Zeiten, Safe-Code) base64-kodiert.
# NICHT von Hand pflegen – kommt aus plan.local.js via `npm run plan`.
VITE_PLAN=

# Crew-Code für den Plan (/plan). Kennt jeder außer dem Bräutigam.
# Leer = keine Code-Abfrage, dann greift nur die Bräutigam-Sperre.
VITE_CREW_PIN=
